{
  "uid": "serverlessrag-red",
  "title": "ServerlessRAG / RED (rate, errors, duration)",
  "description": "OpenTelemetry metrics from the ingest and chat Lambdas, via the OTel Collector",
  "tags": [
    "serverlessrag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(rag_request_duration_seconds_count, route)",
          "refId": "route"
        },
        "definition": "label_values(rag_request_duration_seconds_count, route)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "SLO alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=\"SLOErrorBudgetBurn\",alertstate=\"firing\"}",
        "titleFormat": "{{slo}} burn {{burn_rate}}x",
        "tagKeys": "severity,slo"
      }
    ]
  },
  "links": [
    {
      "title": "SLOs",
      "type": "link",
      "url": "/d/serverlessrag-slo"
    },
    {
      "title": "RED",
      "type": "link",
      "url": "/d/serverlessrag-red"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
