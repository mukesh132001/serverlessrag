{
  "uid": "serverlessrag-slo",
  "title": "ServerlessRAG / SLOs and error budgets",
  "description": "chat-availability: 99.5% non-5xx. chat-latency: 95% of successful requests < 4 s.",
  "tags": [
    "serverlessrag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "slo",
        "label": "SLO",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(slo:objective:ratio, slo)",
          "refId": "slo"
        },
        "definition": "label_values(slo:objective:ratio, slo)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "SLO alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=\"SLOErrorBudgetBurn\",alertstate=\"firing\"}",
        "titleFormat": "{{slo}} burn {{burn_rate}}x",
        "tagKeys": "severity,slo"
      }
    ]
  },
  "links": [
    {
      "title": "SLOs",
      "type": "link",
      "url": "/d/serverlessrag-slo"
    },
    {
      "title": "RED",
      "type": "link",
      "url": "/d/serverlessrag-red"
    }
  ],
  "panels": [
    {
      "id": 25,
      "type": "row",
      "title": "$slo",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "repeat": "slo"
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Objective",
      "description": "",
